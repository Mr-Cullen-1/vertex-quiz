# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is gitignored.

# --- Supabase --------------------------------------------------------------
# From your Supabase project → Project Settings → API. Newer Supabase
# projects label these "Publishable key" and "Secret key"; older projects
# label the same two keys "anon" / "public" and "service_role" — either
# labeling is fine, paste whichever your dashboard shows.

# Public: safe to expose to the browser (used by the Supabase client SDK).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: full database access, bypasses Row Level Security.
# NEVER prefix this with NEXT_PUBLIC_ and never send it to the client.
SUPABASE_SECRET_KEY=

# --- Google Gemini -----------------------------------------------------------
# Server-only: used exclusively in server-side code (Server Actions / Route
# Handlers). NEVER prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=

# --- App ---------------------------------------------------------------------
# Base URL used to build shareable quiz join links and Supabase auth
# redirect URLs (e.g. the password-reset link). Locally: http://localhost:3000.
# In production, set this to the deployed app's real URL, e.g.
# https://vertex-quiz.vercel.app — also add that same
# `https://vertex-quiz.vercel.app/**` (and, for local dev,
# `http://localhost:3000/**`) to Supabase → Authentication → URL
# Configuration → Redirect URLs, or the reset link will be rejected by
# Supabase regardless of what this app sends.
NEXT_PUBLIC_APP_URL=http://localhost:3000
