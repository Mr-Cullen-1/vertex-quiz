# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is gitignored.

# --- Supabase --------------------------------------------------------------
# Public: safe to expose to the browser (used by the Supabase client SDK).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: full database access, bypasses Row Level Security.
# NEVER prefix this with NEXT_PUBLIC_ and never send it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini -----------------------------------------------------------
# Server-only: used exclusively in server-side code (Server Actions / Route
# Handlers). NEVER prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=

# --- App ---------------------------------------------------------------------
# Base URL used to build shareable quiz join links (e.g. http://localhost:3000).
NEXT_PUBLIC_APP_URL=http://localhost:3000
